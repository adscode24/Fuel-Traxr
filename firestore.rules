rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cloud Vault pribadi: dokumen ID == uid pemilik.
    // Setiap email terisolasi: hanya pemilik yang bisa baca/tulis vault-nya sendiri.
    // Login dengan email+sandi yang sama di HP lain (uid sama) -> data sama & tersinkron.
    match /fuelVaults/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Riwayat versi vault (fitur "Riwayat Versi"): snapshot sebelum data ditimpa.
    // Setiap versi hanya boleh diakses oleh pemiliknya (dicek lewat field uid).
    match /fuelVaultVersions/{versionId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
